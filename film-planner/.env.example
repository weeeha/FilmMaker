# Password you type at /login to unlock the AI routes.
APP_PASSWORD=

# Secret used to sign the session cookie. Generate with:
#   openssl rand -base64 32
# Changing APP_PASSWORD or AUTH_SECRET invalidates all existing sessions.
AUTH_SECRET=

# Vercel AI Gateway key used by /api/parse-screenplay and /api/generate-shot.
# Set automatically on Vercel when the AI Gateway integration is linked.
AI_GATEWAY_API_KEY=
